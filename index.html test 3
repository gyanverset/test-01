    // State Variables
    let currentIdx = 0;
    let userAnswers = new Array(100).fill(null);
    let questionStatus = new Array(100).fill('not-visited'); // 'not-visited', 'not-answered', 'answered', 'marked'
    let timerInterval = null;
    let timeLeft = 120 * 60; // 120 minutes in seconds

    function startExam() {
      // Request Fullscreen
      const elem = document.documentElement;
      if (elem.requestFullscreen) {
        elem.requestFullscreen().catch(() => {});
      } else if (elem.webkitRequestFullscreen) {
        elem.webkitRequestFullscreen();
      }

      document.getElementById('start-screen').classList.add('hidden');
      document.getElementById('cbt-screen').classList.remove('hidden');
      
      initPalette();
      loadQuestion(0);
      startTimer();
    }

    function initPalette() {
      const grid = document.getElementById('palette-grid');
      grid.innerHTML = '';
      for (let i = 0; i < 100; i++) {
        const btn = document.createElement('button');
        btn.id = `palette-btn-${i}`;
        btn.className = "h-8 rounded text-xs font-bold transition flex items-center justify-center bg-slate-200 border border-slate-300 text-slate-700 hover:bg-slate-300";
        btn.innerText = i + 1;
        btn.onclick = () => jumpToQuestion(i);
        grid.appendChild(btn);
      }
      updateLegendCounters();
    }

    function updateLegendCounters() {
      let ansCount = 0, notAnsCount = 0, notVisCount = 0, markedCount = 0;
      questionStatus.forEach(st => {
        if (st === 'answered') ansCount++;
        else if (st === 'not-answered') notAnsCount++;
        else if (st === 'marked') markedCount++;
        else notVisCount++;
      });
      document.getElementById('legend-answered').innerText = ansCount;
      document.getElementById('legend-not-answered').innerText = notAnsCount;
      document.getElementById('legend-not-visited').innerText = notVisCount;
      document.getElementById('legend-marked').innerText = markedCount;
    }

    function updatePaletteButton(idx) {
      const btn = document.getElementById(`palette-btn-${idx}`);
      if (!btn) return;
      const st = questionStatus[idx];

      btn.className = "h-8 rounded text-xs font-bold transition flex items-center justify-center ";
      if (st === 'answered') {
        btn.className += "bg-emerald-600 text-white shadow-sm";
      } else if (st === 'marked') {
        btn.className += "bg-amber-500 text-white shadow-sm";
      } else if (st === 'not-answered') {
        btn.className += "bg-rose-500 text-white";
      } else {
        btn.className += "bg-slate-200 border border-slate-300 text-slate-700";
      }

      if (idx === currentIdx) {
        btn.classList.add('ring-2', 'ring-blue-600', 'ring-offset-1');
      }
    }

    function loadQuestion(idx) {
      const prevIdx = currentIdx;
      currentIdx = idx;

      // Update palette ring
      updatePaletteButton(prevIdx);
      if (questionStatus[idx] === 'not-visited') {
        questionStatus[idx] = 'not-answered';
      }
      updatePaletteButton(idx);
      updateLegendCounters();

      const q = questions[idx];
      document.getElementById('q-title').innerText = `Question ${q.id} of 100`;
      document.getElementById('q-text').innerText = q.question;

      const optsBox = document.getElementById('q-options');
      optsBox.innerHTML = '';

      const labels = ['A', 'B', 'C', 'D'];
      q.options.forEach((opt, optIdx) => {
        const isSelected = userAnswers[idx] === optIdx;
        const optDiv = document.createElement('label');
        optDiv.className = `flex items-center p-3 rounded-lg border cursor-pointer transition text-sm ${isSelected ? 'border-blue-600 bg-blue-50 text-blue-900 font-medium' : 'border-slate-200 hover:bg-slate-50 text-slate-800'}`;
        optDiv.innerHTML = `
          <input type="radio" name="opt_choice" value="${optIdx}" ${isSelected ? 'checked' : ''} class="w-4 h-4 text-blue-600 border-slate-300 focus:ring-blue-500 mr-3" onchange="selectOption(${optIdx})">
          <span class="font-bold mr-2 text-slate-500">(${labels[optIdx]})</span>
          <span>${opt}</span>
        `;
        optsBox.appendChild(optDiv);
      });

      document.getElementById('prev-btn').disabled = (idx === 0);
    }

    function selectOption(optIdx) {
      userAnswers[currentIdx] = optIdx;
      questionStatus[currentIdx] = 'answered';
      updatePaletteButton(currentIdx);
      updateLegendCounters();
    }

    function clearResponse() {
      userAnswers[currentIdx] = null;
      questionStatus[currentIdx] = 'not-answered';
      loadQuestion(currentIdx);
    }

    function markForReview() {
      questionStatus[currentIdx] = 'marked';
      updatePaletteButton(currentIdx);
      updateLegendCounters();
      nextQuestion();
    }

    function saveAndNext() {
      if (userAnswers[currentIdx] !== null) {
        questionStatus[currentIdx] = 'answered';
      } else if (questionStatus[currentIdx] !== 'marked') {
        questionStatus[currentIdx] = 'not-answered';
      }
      updatePaletteButton(currentIdx);
      updateLegendCounters();
      nextQuestion();
    }

    function nextQuestion() {
      if (currentIdx < 99) {
        loadQuestion(currentIdx + 1);
      }
    }

    function prevQuestion() {
      if (currentIdx > 0) {
        loadQuestion(currentIdx - 1);
      }
    }

    function jumpToQuestion(idx) {
      if (userAnswers[currentIdx] !== null && questionStatus[currentIdx] !== 'marked') {
        questionStatus[currentIdx] = 'answered';
      }
      loadQuestion(idx);
    }

    function startTimer() {
      const timerDisplay = document.getElementById('timer');
      timerInterval = setInterval(() => {
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          finishTest();
          return;
        }
        timeLeft--;
        const mins = Math.floor(timeLeft / 60);
        const secs = timeLeft % 60;
        timerDisplay.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      }, 1000);
    }

    function confirmSubmit() {
      let answered = userAnswers.filter(a => a !== null).length;
      if (confirm(`क्या आप टेस्ट सबमिट करना चाहते हैं?\n\nकुल प्रश्न: 100\nउत्तर दिए गए: ${answered}\nशेष प्रश्न: ${100 - answered}`)) {
        finishTest();
      }
    }

    function finishTest() {
      clearInterval(timerInterval);
      document.getElementById('cbt-screen').classList.add('hidden');
      document.getElementById('result-screen').classList.remove('hidden');

      // Calculation (+2 for correct, -0.2 for incorrect)
      let correct = 0, wrong = 0, skipped = 0;
      questions.forEach((q, i) => {
        const userA = userAnswers[i];
        if (userA === null) {
          skipped++;
        } else if (userA === q.ans) {
          correct++;
        } else {
          wrong++;
        }
      });

      const totalMarks = (correct * 2.0) - (wrong * 0.2);
      const accuracy = (correct + wrong) > 0 ? ((correct / (correct + wrong)) * 100).toFixed(1) : 0;

      document.getElementById('res-score').innerText = `${totalMarks.toFixed(2)} / 200`;
      document.getElementById('res-correct').innerText = correct;
      document.getElementById('res-wrong').innerText = wrong;
      document.getElementById('res-skipped').innerText = skipped;
      document.getElementById('res-accuracy').innerText = `${accuracy}%`;

      // Render Solutions
      renderSolutions();
    }

    function renderSolutions() {
      const container = document.getElementById('solution-list');
      const pdfContainer = document.getElementById('pdf-content');
      container.innerHTML = '';
      pdfContainer.innerHTML = '';

      const labels = ['A', 'B', 'C', 'D'];

      questions.forEach((q, idx) => {
        const uAns = userAnswers[idx];
        const isCorrect = uAns === q.ans;
        const isSkipped = uAns === null;

        let badge = `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-200 text-slate-700">छोड़ा गया</span>`;
        if (!isSkipped) {
          badge = isCorrect 
            ? `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-emerald-800"><i class="fas fa-check mr-1"></i>सही (+2)</span>`
            : `<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-100 text-rose-800"><i class="fas fa-times mr-1"></i>गलत (-0.2)</span>`;
        }

        const div = document.createElement('div');
        div.className = "p-4 rounded-xl border border-slate-200 bg-slate-50/50 space-y-3";
        div.innerHTML = `
          <div class="flex justify-between items-start gap-2">
            <h4 class="font-bold text-slate-900 text-sm">प्र. ${q.id}. ${q.question.replace(/\n/g, '<br>')}</h4>
            <div>${badge}</div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            ${q.options.map((opt, oIdx) => {
              let optStyle = "border-slate-200 bg-white text-slate-700";
              if (oIdx === q.ans) optStyle = "border-emerald-500 bg-emerald-50 text-emerald-900 font-bold";
              if (!isSkipped && oIdx === uAns && !isCorrect) optStyle = "border-rose-500 bg-rose-50 text-rose-900 font-bold";
              return `<div class="p-2.5 rounded-lg border ${optStyle}">(${labels[oIdx]})${opt}</div>`;
            }).join('')}
          </div>
          <div class="p-3 bg-blue-50/60 border border-blue-100 rounded-lg text-xs text-blue-950">
            <span class="font-bold text-blue-800">व्याख्या: </span> ${q.exp}
          </div>
        `;
        container.appendChild(div);

        // PDF clone
        const pdfItem = document.createElement('div');
        pdfItem.className = "border-b border-gray-300 pb-3 text-sm";
        pdfItem.innerHTML = `
          <p class="font-bold text-black mb-1">Q${q.id}. ${q.question.replace(/\n/g, '<br>')}</p>
          <div class="grid grid-cols-2 gap-1 text-xs text-gray-800 mb-1">
            ${q.options.map((opt, oIdx) => `<div>(${labels[oIdx]})${opt}</div>`).join('')}
          </div>
          <p class="text-xs text-emerald-800 font-bold">सही उत्तर: (${labels[q.ans]}) ${q.options[q.ans]}</p>
          <p class="text-xs text-gray-700 mt-0.5"><b>हल:</b> ${q.exp}</p>
        `;
        pdfContainer.appendChild(pdfItem);
      });
    }

    function downloadTestPDF() {
      if (document.getElementById('pdf-content').children.length === 0) {
        renderSolutions();
      }
      window.print();
    }
  </script>
</body>
